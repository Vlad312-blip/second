import random
import string

def generate_password():
    print("=== PASSWORD GENERATOR ===")
    
    while True:
        try:
            length = int(input("\nEnter the desired password length(from 4 to 8): "))
            if length < 4 or length > 8:
                print("Error: length must be from 4 to 8.")
                continue
        except ValueError:
            print("Error: please enter a valid integer!")
            continue

        use_digits = input("Use digits? (y/n): ").lower() == 'y'
        use_special = input("Use special chars (!@#$%^&*)? (y/n): ").lower() == 'y'

        characters = string.ascii_letters
        
        if use_digits:
            characters += string.digits
        if use_special:
            characters += string.punctuation

        password = ''.join(random.choice(characters) for i in range(length))
        
        print(f"\nYour new password: {password}")

        cont = input("\nGenerate another one? (y/n): ")
        if cont.lower() != 'y':
            print("Exit. Stay safe!")
            break

if __name__ == "__main__":
    generate_password()

